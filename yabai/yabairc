#!/usr/bin/env sh

# Layout config
yabai -m config window_gap                   6
yabai -m config window_placement             second_child
yabai -m config layout                       bsp

# Mouse
yabai -m config mouse_modifier               ctrl
yabai -m config mouse_follows_focus          on
yabai -m config focus_follows_mouse          autofocus

# Debug
yabai -m config debug_output on

# Rules
yabai -m rule --add app="^Dictionary$"         manage=off
yabai -m rule --add app="^System Preferences$" manage=off
yabai -m rule --add app="^Finder$"             manage=off

# Disable management on the built-in display (see gate-builtin.sh)
"$HOME/.config/yabai/gate-builtin.sh"

yabai -m signal --add event=display_added   action='"$HOME/.config/yabai/gate-builtin.sh"'
yabai -m signal --add event=display_removed action='"$HOME/.config/yabai/gate-builtin.sh"'
